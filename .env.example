# Copie para .env e preencha com as chaves da conta PAPER da Alpaca
# (https://app.alpaca.markets > Paper Trading > API Keys). Nunca suba o .env para o GitHub.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# paper (padrão) ou live. A conta real só abre com as DUAS linhas abaixo preenchidas.
TRADE_CITY_MODE=paper
# TRADE_CITY_LIVE=EU_ACEITO_O_RISCO
